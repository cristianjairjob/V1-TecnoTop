generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}
datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}
enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  PREPARANDO
  DESPACHADO
  VALIDANDO
  ENVIANDO_A_DROPI
  ACEPTADO_POR_DROPI
  ERROR_DROPI
  GUIA_GENERADA
  EN_TRANSITO
  EN_REPARTO
  ENTREGADO
  DEVUELTO
  CANCELADO
}
model Product {
  id String @id @default(cuid())
  dropiId String? @unique
  slug String @unique
  name String @db.VarChar(255)
  description String @db.Text
  uploadedImages ProductImage[]
  images Json
  supplierPrice Decimal @default(0) @db.Decimal(12,2)
  salePrice Decimal? @db.Decimal(12,2)
  previousPrice Decimal? @db.Decimal(12,2)
  combo2Price Decimal? @db.Decimal(12,2)
  combo3Price Decimal? @db.Decimal(12,2)
  buyersCount Int?
  pairBestSeller Boolean @default(false)
  buyerAvatars Json?
  colorOptions Json?
  stock Int @default(0)
  status ProductStatus @default(DRAFT)
  brand String?
  supplierId String?
  supplierName String?
  categoryId String?
  category Category? @relation(fields:[categoryId], references:[id])
  collections CollectionProduct[]
  variants ProductVariant[]
  dropi DropiProduct?
  featured Boolean @default(false)
  popular Boolean @default(false)
  position Int @default(0)
  syncedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, categoryId])
}
model ProductVariant {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields:[productId], references:[id], onDelete:Cascade)
  dropiId String
  name String @db.Text
  sku String?
  attributes Json
  stock Int @default(0)
  supplierPrice Decimal @default(0) @db.Decimal(12,2)
  salePrice Decimal? @db.Decimal(12,2)
  active Boolean @default(true)
  @@unique([productId,dropiId])
}
model Category {
  id String @id @default(cuid())
  slug String @unique
  name String
  description String @db.Text
  position Int @default(0)
  visible Boolean @default(true)
  products Product[]
  collections Collection[]
}
model Collection {
  id String @id @default(cuid())
  slug String @unique
  name String
  description String @db.Text
  position Int @default(0)
  visible Boolean @default(true)
  categoryId String
  category Category @relation(fields:[categoryId],references:[id])
  products CollectionProduct[]
}
model CollectionProduct {
  collectionId String
  productId String
  position Int @default(0)
  collection Collection @relation(fields:[collectionId],references:[id],onDelete:Cascade)
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  @@id([collectionId,productId])
}
model Customer {
  firstName String? @db.VarChar(80)
  lastName String? @db.VarChar(80)
  id String @id @default(cuid())
  name String
  email String
  phone String
  phoneNormalized String?
  orders Order[]
  createdAt DateTime @default(now())
  @@index([phone])
}
model Cart {
  id String @id @default(cuid())
  tokenHash String @unique
  items CartItem[]
  updatedAt DateTime @updatedAt
  expiresAt DateTime
}
model CartItem {
  id String @id @default(cuid())
  cartId String
  cart Cart @relation(fields:[cartId],references:[id],onDelete:Cascade)
  productId String
  variantId String @default("")
  quantity Int
  @@unique([cartId,productId,variantId])
}
model Order {
  id String @id @default(cuid())
  number String @unique
  idempotencyKey String @unique
  requestHash String
  status OrderStatus @default(PENDIENTE)
  customerId String
  customer Customer @relation(fields:[customerId],references:[id])
  address Json
  deliveryNotes String? @db.Text
  subtotal Decimal @db.Decimal(12,2)
  discount Decimal @default(0) @db.Decimal(12,2)
  shipping Decimal @default(0) @db.Decimal(12,2)
  total Decimal @db.Decimal(12,2)
  promotionCode String?
  paymentMethod String @default("CONTRAENTREGA")
  pricingSnapshot Json?
  privacyVersion String
  items OrderItem[]
  dropi DropiOrder?
  shipments Shipment[]
  events TrackingEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status,createdAt])
}
model OrderItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId],references:[id])
  productId String
  variantId String?
  dropiId String?
  dropiVariantId String?
  name String @db.Text
  quantity Int
  unitPrice Decimal @db.Decimal(12,2)
  supplierPrice Decimal @db.Decimal(12,2)
  supplierId String?
  snapshot Json
}
model Shipment {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId],references:[id])
  guide String?
  carrier String?
  logisticsCost Decimal? @db.Decimal(12,2)
  source String
  createdAt DateTime @default(now())
}
model TrackingEvent {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId],references:[id])
  status OrderStatus
  detail String @db.Text
  source String
  createdAt DateTime @default(now())
}
model DropiProduct {
  id String @id @default(cuid())
  productId String @unique
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  originalId String @unique
  payload Json
  syncedAt DateTime @default(now())
}
model DropiOrder {
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields:[orderId],references:[id])
  originalId String? @unique
  response Json?
  attemptedAt DateTime?
  outcome String @default("NOT_SENT")
  errorCode String?
}
model Promotion {
  id String @id @default(cuid())
  code String @unique
  title String @db.VarChar(255)
  percent Int
  minimum Decimal @default(0) @db.Decimal(12,2)
  active Boolean @default(false)
  startsAt DateTime
  endsAt DateTime
}
model AdminUser {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  active Boolean @default(true)
  sessions AdminSession[]
  createdAt DateTime @default(now())
}
model AdminSession {
  id String @id @default(cuid())
  tokenHash String @unique
  adminId String
  admin AdminUser @relation(fields:[adminId],references:[id],onDelete:Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
model SyncLog {
  id String @id @default(cuid())
  operation String
  status String
  count Int @default(0)
  errorCode String?
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(cuid())
  adminId String
  action String @db.Text
  entityId String
  createdAt DateTime @default(now())
}
model SiteSetting {
  key String @id
  value Json
}
model RateLimit {
  key String @id
  count Int @default(1)
  expiresAt DateTime
}
model Notification {
  attempts Int @default(0)
  sentAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  parts NotificationPart[]
  id String @id @default(cuid())
  orderId String
  channel String
  event String
  status String @default("PENDING_CONFIGURATION")
  @@unique([orderId,channel,event])
}

model ProductImage {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields:[productId], references:[id], onDelete:Cascade)
  data Bytes @db.LongBlob
  createdAt DateTime @default(now())
  @@index([productId])
}

model NotificationPart {
 id String @id @default(cuid())
 notificationId String
 notification Notification @relation(fields:[notificationId],references:[id],onDelete:Cascade)
 position Int
 text String @db.Text
 status String @default("PENDING")
 attempts Int @default(0)
 messageId String?
 sentAt DateTime?
 startedAt DateTime?
 lastError String?
 @@unique([notificationId,position])
}
model TelegramLinkCode {
 id String @id @default(cuid())
 codeHash String @unique
 adminId String
 sessionId String
 expiresAt DateTime
 usedAt DateTime?
 createdAt DateTime @default(now())
}
